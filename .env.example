# Copy this file to .env.local if you need to override anything below.

# Only needed if the `claude` command isn't on your PATH — set this to the
# full path of the claude executable, e.g. C:\Users\you\AppData\Local\Programs\claude\claude.exe
# CLAUDE_CLI_PATH=claude

# Needed only for the "email me new job matches" discovery feature. Generate
# a Gmail app password at https://myaccount.google.com/apppasswords (requires
# 2-Step Verification to be turned on) — do NOT use your real account
# password. These are read server-side only; they're never stored in the
# database or exposed through any API/UI.
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=your16charapppassword
